# Copy this file to .env and replace the placeholders before starting.
POSTGRES_DB=datapulse
POSTGRES_USER=datapulse
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD

DATAPULSE_JWT_SECRET_BASE64=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_BASE64_32
DATAPULSE_SEED_ADMIN_EMAIL=admin@datapulse.local
DATAPULSE_SEED_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD
DATAPULSE_SEED_ANALYST_EMAIL=analyst@datapulse.local
DATAPULSE_SEED_ANALYST_PASSWORD=REPLACE_WITH_LOCAL_ANALYST_PASSWORD

DATAPULSE_CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8080/api
